load("//defs/packages:autotools.bzl", "autotools_package")

autotools_package(
    name = "btrfs-progs",
    # v7.0+ for reproducible mkfs.btrfs --rootdir (SOURCE_DATE_EPOCH support);
    # v6.7 --rootdir is not byte-reproducible, which broke verity_image root hashes.
    url = "https://mirrors.edge.kernel.org/pub/linux/kernel/people/kdave/btrfs-progs/btrfs-progs-v7.0.tar.xz",

    sha256 = "c286d6876cbcd72327a0b417e4cfd280353ec23e37b549fdbcd7800a832d9a99",
    use_configure = {
        "convert": ("--enable-convert", "--disable-convert"),
        "experimental": ("--enable-experimental", "--disable-experimental"),
        "static": ("--enable-static", "--disable-static"),
        "static-libs": ("--enable-static", "--disable-static"),
    },
    version = "7.0",
    description = "Btrfs filesystem utilities (mkfs.btrfs, btrfs-check, etc.)",
    homepage = "https://btrfs.wiki.kernel.org/",
    license = "GPL-2.0",
    configure_args = [
        "--disable-documentation",
        "--disable-python",
        "--disable-convert",
        "--disable-libudev",
    ],
    deps = [
        "//packages/linux/core/util-linux:util-linux",
        "//packages/linux/core/zlib:zlib",
        "//packages/linux/system/libs/compression/lzo:lzo",
        "//packages/linux/system/libs/compression/zstd:zstd",
    ],
)
