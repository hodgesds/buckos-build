# dm-verity measured-boot fragment.
#
# Layered on top of live.config (which already boots in QEMU and carries btrfs
# + sha256), this forces the device-mapper + dm-verity stack to be *built-in*
# rather than modules (live.config has CONFIG_DM_VERITY=m / CONFIG_BLK_DEV_DM=m).
# Built-in keeps the verity-boot initramfs simple: no module loading before the
# rootfs is verified.  Used by the buckos-kernel-verity boot-test kernel.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_CRYPTO_SHA256=y
# Filesystems the measured rootfs may use (btrfs is hatch parity; ext4 fallback)
CONFIG_BTRFS_FS=y
CONFIG_EXT4_FS=y
# virtio block (QEMU presents the data + hash images as virtio disks) + initrd
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
